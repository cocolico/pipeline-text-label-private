)
from stage5_bbox_tracking import BBoxConfig, default_hand_detector_path, _resolve_hand_device

_DEPTH_CHUNK_CACHE_SIZE = 4


def _longest_continuous_hand_run(
    *,
    start_frame: int,
    end_frame: int,
    frame_stride: int,
    hand_frames: Dict[int, List[Dict[str, Any]]],
    hand_score_threshold: float,
    source_fps: float,
) -> Tuple[int, float]:
    """Return the longest run of consecutive sampled frames containing a hand.

    Duration is the elapsed time from the first to the last positive sample in
    the run. A single detection therefore has duration 0 rather than being
    credited with a full sampling interval.
    """
    stride = max(1, int(frame_stride))
    longest_count = current_count = 0
    run_start: Optional[int] = None
    longest_duration = current_duration = 0.0
    fps = float(source_fps) if float(source_fps) > 0 else 30.0
    for frame_idx in range(int(start_frame), max(int(end_frame), int(start_frame) + 1), stride):
        hands = hand_frames.get(frame_idx, [])
        present = any(
            isinstance(hand, dict) and float(hand.get("score", 0.0)) >= float(hand_score_threshold)
            for hand in hands
        )
        if present:
            if run_start is None:
                run_start = frame_idx
                current_count = 1
            else:
                current_count += 1
            current_duration = max(0.0, float(frame_idx - run_start) / fps)
            if current_duration > longest_duration or (
                current_duration == longest_duration and current_count > longest_count
            ):
                longest_count = current_count
                longest_duration = current_duration
        else:
            run_start = None
            current_count = 0
            current_duration = 0.0
    return longest_count, longest_duration


def _validate_vlm_action_value(obj: Any) -> Tuple[Optional[str], str, List[str]]:
    if not isinstance(obj, dict):
        return None, "", ["Response must be a JSON object."]
    value = str(obj.get("value", "")).strip().lower()
    reason = str(obj.get("reason", "")).strip()
    errors: List[str] = []
    if value not in {"yes", "no"}:
        errors.append("'value' must be exactly 'yes' or 'no'.")
    if not reason:
        errors.append("'reason' must be a non-empty string grounded in visible evidence.")
    return (value if not errors else None), reason, errors


def _build_hand_focus_cues(
    *,
    video_path: str,
    seg: Dict[str, Any],
    hand_frames: Dict[int, List[Dict[str, Any]]],
    hand_score_threshold: float,
    max_cues: int = 24,
) -> str:
    """Serialize sparse YOLO hand boxes as normalized VLM attention cues.

    The boxes are hints only: the VLM must still judge action semantics from the
    original video. Sampling keeps the prompt bounded for long clips.
    """
    import cv2

    cap = cv2.VideoCapture(video_path)
    try:
        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)) or 1
        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)) or 1
        fps = float(cap.get(cv2.CAP_PROP_FPS)) or 30.0
    finally:
        cap.release()
    start = int(seg.get("start_frame_0based", 0))
    end = int(seg.get("end_frame_0based_exclusive", start))
    positive: List[Tuple[int, List[Dict[str, Any]]]] = []
    for frame_idx in sorted(k for k in hand_frames if start <= int(k) < end):
        boxes = [
            hand for hand in hand_frames.get(frame_idx, [])
            if isinstance(hand, dict) and float(hand.get("score", 0.0)) >= float(hand_score_threshold)
        ]
        if boxes:
            positive.append((int(frame_idx), boxes))
    if not positive:
        return "YOLO found no confident hand boxes in this step clip."
    if len(positive) > max(1, int(max_cues)):
        count = max(1, int(max_cues))
        chosen = sorted({round(i * (len(positive) - 1) / max(1, count - 1)) for i in range(count)})
        positive = [positive[i] for i in chosen]
    lines = [
        "YOLO hand-location attention cues (normalized coordinates in the ORIGINAL video; x/y range 0..1):"
    ]
    for frame_idx, boxes in positive:
        parts: List[str] = []
        for hand in boxes:
            raw = hand.get("bbox_xyxy", [])
            if not isinstance(raw, list) or len(raw) != 4:
                continue
            x1, y1, x2, y2 = [float(v) for v in raw]
            parts.append(
                f"{hand.get('hand', 'hand')} score={float(hand.get('score', 0.0)):.2f} "
                f"bbox=[{x1/width:.3f},{y1/height:.3f},{x2/width:.3f},{y2/height:.3f}]"
            )
        if parts:
            lines.append(f"- clip_t={(frame_idx-start)/fps:.2f}s source_frame={frame_idx}: " + "; ".join(parts))
    return "\n".join(lines)


def _judge_step_action_with_vlm(
    *,
    client: Any,
    api_cfg: ApiConfig,
    clip_path: str,
    step_goal: str,
    step_id: Any,
    hand_focus_cues: str,
    max_retries: int = 3,
) -> Tuple[str, str, Dict[str, int]]:
    """Use the configured Volcengine VLM to verify actual goal execution."""
    prompt = f"""You are validating whether a task step was actually performed in a video clip.

Step ID: {step_id}
Target action: {step_goal}

{hand_focus_cues}

Use the YOLO boxes only as spatial attention hints: focus first on the hands inside those regions, then inspect the nearby contacted objects and their before/after state changes. The boxes do not prove that an action occurred and may contain detection errors. Do not ignore relevant hand motion during short YOLO gaps; verify everything against the original video.

Return value=yes ONLY when the visible video provides positive evidence that the target action itself is actually executed. Mere presence of hands, people, tools, or target objects is NOT sufficient. Incidental motion, preparation without execution, an unrelated action, or insufficient/ambiguous evidence MUST be value=no.

Return exactly one JSON object:
{{"value":"yes" or "no","reason":"concise visible evidence supporting the decision"}}
"""
    video_content = build_video_api_content(
        clip_path, [], video_fps=float(api_cfg.video_fps), include_manifest=False
    )
    usage = {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0, "api_calls": 0}
    last_errors: List[str] = []
    last_content = ""
    for attempt in range(1, max(1, int(max_retries)) + 1):
        retry = ""
        if last_errors:
            retry = "Previous response was invalid: " + " | ".join(last_errors) + "\nPrevious response: " + last_content + "\n\n"
        messages = [
            {"role": "system", "content": "You are a strict video action verifier. Output JSON only."},
            {"role": "user", "content": [{"type": "text", "text": retry + prompt}] + video_content},
        ]
        content, call_usage = call_chat_completion(client, api_cfg, messages, max_tokens=1200)
        usage["prompt_tokens"] += int(call_usage.get("prompt_tokens", 0) or 0)
        usage["completion_tokens"] += int(call_usage.get("completion_tokens", 0) or 0)
        usage["total_tokens"] += int(call_usage.get("total_tokens", 0) or 0)
        usage["api_calls"] += 1
        last_content = content
        try:
            obj = json.loads(extract_json_from_response(content))
        except Exception as exc:
            last_errors = [f"JSON parse error: {exc}"]
            continue
        value, reason, errors = _validate_vlm_action_value(obj)
        if value is not None:
            return value, reason, usage
        last_errors = errors
    raise RuntimeError(
        f"Stage 2h VLM action verification failed for step_id={step_id}: "
        + " | ".join(last_errors[:5])
    )


def _can_resume_stage2h(qc_summary_path: str, segments_path: str) -> bool:
    if not (os.path.exists(qc_summary_path) and os.path.exists(segments_path)):
        return False
    try:
        qc = read_json(qc_summary_path)
        steps = qc.get("steps", [])
        segs = read_json(segments_path).get("segments", [])
    except Exception:
        return False
    if not isinstance(steps, list) or not isinstance(segs, list) or not steps or not segs:
        return False
    if qc.get("value_gate_version") != "yolo-continuous-gt-1s-and-vlm-v1":
        return False
    if len(steps) != len(segs):
        return False
    # Check if value write-back has completed (presence of value_pre_qc indicates the new logic ran)
    if not any(isinstance(seg, dict) and "value_pre_qc" in seg for seg in segs):
        return False
    return True


def _camera_dir_for_video(video_path: str) -> str:
    # Shared convention with output-root placement: <camera_dir>/raw_data/<video>.mp4,
    # <camera_dir>/processed_text_label/, <camera_dir>/processed_refined_depth/.
    return os.path.dirname(os.path.dirname(os.path.abspath(video_path)))


def _detect_hands_for_ranges(
    video_path: str,
    frame_ranges: List[Tuple[int, int, int]],
    cfg: BBoxConfig,
    device: str,
) -> Dict[int, List[Dict[str, Any]]]:
    """Run YOLOv8 hand detection on sampled frames within specified ranges.

    Args:
        video_path: Path to source video file.
        frame_ranges: List of (start_frame_0based, end_frame_0based_exclusive, stride) tuples.
        cfg: BBoxConfig with hand_detector/hand_conf/hand_iou/hand_batch_size.
        device: Resolved device string ("cuda", "cpu", etc.).

    Returns:
        Dict mapping frame_idx -> list of hand detections, where each detection is
        {"score": float, "bbox_xyxy": [x1,y1,x2,y2], "hand": "left"/"right"}.
    """
    import cv2
    import torch
    from ultralytics import YOLO

    detector_path = cfg.hand_detector or default_hand_detector_path()
    detector_path = os.path.abspath(os.path.expanduser(detector_path))
    if not os.path.isfile(detector_path):
        raise FileNotFoundError(f"WiLoR hand detector not found: {detector_path}")

    # Monkeypatch torch.load to allow loading WiLoR's legacy PoseModel checkpoint
    original_torch_load = torch.load

    def trusted_checkpoint_load(*args: Any, **kwargs: Any) -> Any:
        kwargs.setdefault("weights_only", False)
        return original_torch_load(*args, **kwargs)

    torch.load = trusted_checkpoint_load
    try:
        detector = YOLO(detector_path)
    finally:
        torch.load = original_torch_load

    # Build set of all frame indices to sample
    frame_set: Set[int] = set()
    for start, end, stride in frame_ranges:
        frame_set.update(range(start, end, max(1, stride)))
    if not frame_set:
        return {}

    sorted_frames = sorted(frame_set)
    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        raise RuntimeError(f"Cannot open video for hand detection: {video_path}")

    try:
        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    except Exception:
        width, height = 1920, 1080

    hand_frames: Dict[int, List[Dict[str, Any]]] = {}
    batch_frames: List[Any] = []
    batch_indices: List[int] = []
    batch_size = max(1, int(cfg.hand_batch_size))

    def flush() -> None:
        if not batch_frames:
            return
        results = detector.predict(
            source=batch_frames,
            conf=float(cfg.hand_conf),
            iou=float(cfg.hand_iou),
            device=device,
            verbose=False,
        )
        for frame_idx, result in zip(batch_indices, results):
            boxes = result.boxes
            if boxes is None:
                hand_frames[frame_idx] = []
                continue
            detections: List[Dict[str, Any]] = []
            try:
                xyxy_values = boxes.xyxy.detach().cpu().numpy().tolist()
                class_values = boxes.cls.detach().cpu().numpy().tolist()
                conf_values = boxes.conf.detach().cpu().numpy().tolist()
            except Exception:
                hand_frames[frame_idx] = []
                continue
            for raw_box, raw_class, raw_conf in zip(xyxy_values, class_values, conf_values):
                label = "right" if int(raw_class) == 1 else "left"
                x1, y1, x2, y2 = raw_box
                x1 = max(0.0, min(float(width), float(x1)))
                y1 = max(0.0, min(float(height), float(y1)))
                x2 = max(0.0, min(float(width), float(x2)))
                y2 = max(0.0, min(float(height), float(y2)))
                if x2 <= x1 or y2 <= y1:
                    continue
                detections.append(
                    {
                        "score": float(raw_conf),
                        "bbox_xyxy": [x1, y1, x2, y2],
                        "hand": label,
                    }
                )
            hand_frames[frame_idx] = detections
        batch_frames.clear()
        batch_indices.clear()

    try:
        for frame_idx in sorted_frames:
            cap.set(cv2.CAP_PROP_POS_FRAMES, frame_idx)
            ok, frame = cap.read()
            if not ok:
                hand_frames[frame_idx] = []
                continue
            batch_frames.append(frame)
            batch_indices.append(frame_idx)
            if len(batch_frames) >= batch_size:
                flush()
        flush()
    finally:
        cap.release()

    return hand_frames


def _build_depth_chunk_index(depth_dir: str, index_cache_path: str) -> Optional[List[Tuple[int, int, str]]]:
    """Return [(chunk_start_frame, frame_count, npz_path), ...] sorted by chunk start, or None."""
    if not os.path.isdir(depth_dir):
        return None

    npz_files = sorted(
        f for f in os.listdir(depth_dir) if f.startswith("refined_depth_") and f.endswith(".npz")
    )
    if not npz_files:
        return None

    # Reuse a cached index if it matches the current file listing, so a resumed run doesn't
    # re-decompress every chunk just to read its frame count again.
    if os.path.exists(index_cache_path):
        try:
            cached = read_json(index_cache_path)
            if cached.get("files") == npz_files:
                chunks = cached.get("chunks", [])
                return [(int(c["start"]), int(c["count"]), os.path.join(depth_dir, c["file"])) for c in chunks]
        except Exception:
            pass

    manifest_counts: Dict[str, int] = {}
    manifest_path = os.path.join(os.path.dirname(depth_dir), "raw_data", "manifest.json")
    if os.path.isfile(manifest_path):
        try:
            manifest = read_json(manifest_path)
            for chunk in manifest.get("aligned_depth_storage", {}).get("chunks", []) or []:
                name = str(chunk.get("name", "")).replace("aligned_depth_", "refined_depth_")
                if name and chunk.get("frame_count") is not None:
                    manifest_counts[name] = int(chunk.get("frame_count"))
        except Exception:
            manifest_counts = {}

    chunks: List[Tuple[int, int, str]] = []
    cursor = 0
    for fname in npz_files:
        count = manifest_counts.get(fname)
        if count is None:
            try:
                with np.load(os.path.join(depth_dir, fname)) as z:
                    count = int(z["depth_refined"].shape[0])
            except Exception as e:
                logger.warning(f"[stage2h] Failed to read depth chunk {fname}: {type(e).__name__}: {e}")
                return None
        chunks.append((cursor, count, os.path.join(depth_dir, fname)))
        cursor += count

    try:
        write_json(
            index_cache_path,
            {
                "files": npz_files,
                "chunks": [
                    {"start": start, "count": count, "file": os.path.basename(path)}
                    for start, count, path in chunks
                ],
            },
        )
    except Exception:
        pass
    return chunks


class _DepthChunkReader:
    """Loads refined_depth_*.npz chunks on demand, keeping only a few decompressed in memory."""

    def __init__(self, chunks: List[Tuple[int, int, str]]):
        self._chunks = chunks
        self._cache: Dict[str, np.ndarray] = {}
        self._order: List[str] = []

    def _chunk_for_frame(self, frame_idx: int) -> Optional[Tuple[int, str]]:
        for start, count, path in self._chunks:
            if start <= frame_idx < start + count:
                return frame_idx - start, path
        return None

    def frame_depth(self, frame_idx: int) -> Optional[np.ndarray]:
        located = self._chunk_for_frame(frame_idx)
        if located is None:
            return None
        local_idx, path = located
        arr = self._cache.get(path)
        if arr is None:
            try:
                with np.load(path) as z:
                    arr = np.asarray(z["depth_refined"])
            except Exception as e:
                logger.warning(f"[stage2h] Failed to load depth chunk {path}: {type(e).__name__}: {e}")
                return None
            self._cache[path] = arr
            self._order.append(path)
            if len(self._order) > _DEPTH_CHUNK_CACHE_SIZE:
                oldest = self._order.pop(0)
                self._cache.pop(oldest, None)
        if local_idx >= arr.shape[0]:
            return None
        return arr[local_idx]


def _median_depth_in_bbox(depth_frame: np.ndarray, bbox_xyxy: List[float]) -> Optional[float]:
    h, w = depth_frame.shape[:2]
    x0, y0, x1, y1 = bbox_xyxy
    xi0 = max(0, int(round(x0)))
    yi0 = max(0, int(round(y0)))
    xi1 = min(w, int(round(x1)))
    yi1 = min(h, int(round(y1)))
    if xi1 <= xi0 or yi1 <= yi0:
        return None
    region = depth_frame[yi0:yi1, xi0:xi1]
    valid = region[region > 0]
    if valid.size == 0:
        return None
    return float(np.median(valid))


def _qc_one_segment(
    seg: Dict[str, Any],
    *,
    hand_frames: Optional[Dict[int, List[Dict[str, Any]]]],
    depth_reader: Optional[_DepthChunkReader],
    frame_stride: int,
    hand_score_threshold: float,
    hand_presence_min_ratio: float,
    near_far_threshold_mm: float,
) -> Dict[str, Any]:
    start = int(seg.get("start_frame_0based", 0))
    end = int(seg.get("end_frame_0based_exclusive", start))
    sample_frames = list(range(start, max(end, start + 1), max(1, int(frame_stride))))

    result: Dict[str, Any] = {
        "step_id": seg.get("step_id"),
        "clip_relpath": seg.get("clip_relpath"),
        "start_frame_0based": start,
        "end_frame_0based_exclusive": end,
        "sampled_frame_count": len(sample_frames),
    }

    if hand_frames is None:
        result.update(
            {
                "hand_status": "unknown_no_hand_data",
                "hand_present_frame_count": None,
                "hand_presence_ratio": None,
                "field_label": "unknown_no_hand_data",
                "median_hand_depth_mm": None,
                "near_frame_count": None,
                "far_frame_count": None,
            }
        )
        return result

    present = 0
    depths_mm: List[float] = []
    for f_idx in sample_frames:
        hands = hand_frames.get(f_idx, [])
        confident = [
            h for h in hands if isinstance(h, dict) and float(h.get("score", 0.0)) >= hand_score_threshold
        ]
        if not confident:
            continue
        present += 1
        if depth_reader is None:
            continue
        depth_frame = depth_reader.frame_depth(f_idx)
        if depth_frame is None:
            continue
        for h in confident:
            bbox = h.get("bbox_xyxy")
            if not bbox or len(bbox) != 4:
                continue
            d = _median_depth_in_bbox(depth_frame, bbox)
            if d is not None:
                depths_mm.append(d)

    ratio = (present / len(sample_frames)) if sample_frames else 0.0
    result["hand_present_frame_count"] = present
    result["hand_presence_ratio"] = ratio
    result["hand_status"] = "pass" if ratio >= hand_presence_min_ratio else "fail_no_hand"

    if depth_reader is None:
        result["field_label"] = "unknown_no_depth_data"
        result["median_hand_depth_mm"] = None
        result["near_frame_count"] = None
        result["far_frame_count"] = None
    elif not depths_mm:
        result["field_label"] = "unknown"
        result["median_hand_depth_mm"] = None
        result["near_frame_count"] = 0
        result["far_frame_count"] = 0
    else:
        near = sum(1 for d in depths_mm if d < near_far_threshold_mm)
        far = len(depths_mm) - near
        result["near_frame_count"] = near
        result["far_frame_count"] = far
        result["median_hand_depth_mm"] = float(np.median(depths_mm))
        result["field_label"] = "near" if near >= far else "far"

    return result


def run_stage2h_for_video(
    video_path: str,
    output_root: str,
    overwrite: bool,
    *,
    bbox_cfg: BBoxConfig,
    api_cfg: ApiConfig,
    frame_stride: int = 3,
    hand_score_threshold: float = 0.5,
    hand_presence_min_ratio: float = 0.5,
    near_far_threshold_mm: float = 700.0,
    allow_legacy_resume: bool = False,
) -> str:
    t_start = time.perf_counter()
    vid = video_id_from_path(video_path)
    video_out = os.path.join(output_root, vid)
    ensure_video_out_dir_safe(video_out, video_path)

    stage2_dir = os.path.join(video_out, "stage2")
    segments_path = os.path.join(stage2_dir, "step_segments.json")
    stage2h_dir = os.path.join(video_out, "stage2h")
    qc_summary_path = os.path.join(stage2h_dir, "qc_summary.json")
    run_summary_path = os.path.join(video_out, "run_summary.json")

    will_resume = not overwrite and _can_resume_stage2h(qc_summary_path, segments_path)
    schema_fp = guard_schema_fingerprint(
        run_summary_path,
        video_out,
        stage="Stage 2h",
        overwrite=overwrite,
        allow_legacy_resume=allow_legacy_resume,
        will_resume=will_resume,
    )
    if will_resume:
        logger.info(f"[stage2h] video_id={vid} resume: {os.path.relpath(video_out, output_root)}")
        return video_out

    if not os.path.exists(segments_path):
        raise FileNotFoundError(f"Stage 2 segments not found: {segments_path}")

    segments_data = read_json(segments_path)
    segments = segments_data.get("segments", [])
    if not isinstance(segments, list) or not segments:
        raise RuntimeError(f"Stage 2 segments file has no usable segments: {segments_path}")

    source_fps = float(segments_data.get("source_video_fps", 30.0) or 30.0)
    logger.info(f"[stage2h] video_id={vid} start: overwrite={bool(overwrite)} steps={len(segments)}")
    client = initialize_api_client(api_cfg)
    if not client:
        raise SystemExit("Failed to initialize API client for Stage 2h action verification.")

    # Build frame ranges for YOLO detection
    frame_ranges: List[Tuple[int, int, int]] = []
    for seg in segments:
        if not isinstance(seg, dict):
            continue
        start = int(seg.get("start_frame_0based", 0))
        end = int(seg.get("end_frame_0based_exclusive", start))
        frame_ranges.append((start, end, frame_stride))

    # Run real YOLOv8 hand detection on source video
    device = _resolve_hand_device(bbox_cfg.hand_device)
    try:
        hand_frames = _detect_hands_for_ranges(video_path, frame_ranges, bbox_cfg, device)
    except Exception as e:
        logger.error(f"[stage2h] video_id={vid} YOLOv8 hand detection failed: {type(e).__name__}: {e}")
        raise

    logger.info(f"[stage2h] video_id={vid} YOLOv8 detected hands in {len([f for f in hand_frames.values() if f])} / {len(hand_frames)} sampled frames")

    # Load depth data
    camera_dir = _camera_dir_for_video(video_path)
    depth_dir = os.path.join(camera_dir, "processed_refined_depth")
    depth_chunks = _build_depth_chunk_index(depth_dir, os.path.join(stage2h_dir, "_depth_chunk_index.json"))
    depth_reader = _DepthChunkReader(depth_chunks) if depth_chunks else None
    if depth_reader is None:
        logger.warning(
            f"[stage2h] video_id={vid} no usable depth data under {depth_dir}; "
            "field_label will be 'unknown_no_depth_data' for all steps"
        )

    step_results: List[Dict[str, Any]] = []
    stage_usage = {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0, "api_calls": 0}
    for seg in segments:
        if not isinstance(seg, dict):
            continue
        qc_result = _qc_one_segment(
            seg,
            hand_frames=hand_frames,
            depth_reader=depth_reader,
            frame_stride=frame_stride,
            hand_score_threshold=hand_score_threshold,
            hand_presence_min_ratio=hand_presence_min_ratio,
            near_far_threshold_mm=near_far_threshold_mm,
        )

        longest_count, continuous_sec = _longest_continuous_hand_run(
            start_frame=int(seg.get("start_frame_0based", 0)),
            end_frame=int(seg.get("end_frame_0based_exclusive", 0)),
            frame_stride=frame_stride,
            hand_frames=hand_frames,
            hand_score_threshold=hand_score_threshold,
            source_fps=source_fps,
        )
        # Strictly greater than one second, as opposed to the old accumulated
        # (possibly discontinuous) hand-presence duration heuristic.
        yolo_value = "yes" if continuous_sec > 1.0 else "no"
        clip_relpath = str(seg.get("clip_relpath", "") or "")
        clip_path = os.path.join(stage2_dir, clip_relpath)
        if not clip_relpath or not os.path.isfile(clip_path):
            raise FileNotFoundError(f"Stage 2 clip not found for step_id={seg.get('step_id')}: {clip_path}")
        vlm_value, vlm_reason, vlm_usage = _judge_step_action_with_vlm(
            client=client,
            api_cfg=api_cfg,
            clip_path=clip_path,
            step_goal=str(seg.get("step_goal", "")).strip(),
            step_id=seg.get("step_id"),
            hand_focus_cues=_build_hand_focus_cues(
                video_path=video_path,
                seg=seg,
                hand_frames=hand_frames,
                hand_score_threshold=hand_score_threshold,
            ),
        )
        for key in stage_usage:
            stage_usage[key] += int(vlm_usage.get(key, 0) or 0)

        qc_result["longest_continuous_hand_sample_count"] = longest_count
        qc_result["longest_continuous_hand_duration_sec"] = continuous_sec
        qc_result["yolo_value"] = yolo_value
        qc_result["vlm_value"] = vlm_value
        qc_result["vlm_reason"] = vlm_reason
        qc_result["value"] = "yes" if yolo_value == "yes" and vlm_value == "yes" else "no"
        step_results.append(qc_result)

    num_hand_fail = sum(1 for r in step_results if r.get("hand_status") == "fail_no_hand")
    num_near = sum(1 for r in step_results if r.get("field_label") == "near")
    num_far = sum(1 for r in step_results if r.get("field_label") == "far")
    num_value_no = sum(1 for r in step_results if r.get("value") == "no")

    os.makedirs(stage2h_dir, exist_ok=True)
    write_json(
        qc_summary_path,
        {
            "value_gate_version": "yolo-continuous-gt-1s-and-vlm-v1",
            "source_video": os.path.abspath(video_path),
            "params": {
                "frame_stride": int(frame_stride),
                "hand_score_threshold": float(hand_score_threshold),
                "hand_presence_min_ratio": float(hand_presence_min_ratio),
                "near_far_threshold_mm": float(near_far_threshold_mm),
                "hand_detector": bbox_cfg.hand_detector or default_hand_detector_path(),
                "hand_conf": float(bbox_cfg.hand_conf),
                "hand_iou": float(bbox_cfg.hand_iou),
                "hand_device": device,
            },
            "depth_data_available": depth_reader is not None,
            "token_usage": stage_usage,
            "steps": step_results,
            "summary": {
                "num_steps": len(step_results),
                "num_hand_fail": num_hand_fail,
                "num_near": num_near,
                "num_far": num_far,
                "num_value_no": num_value_no,
            },
        },
    )

    # Write value field back to step_segments.json
    for i, seg in enumerate(segments):
        if not isinstance(seg, dict):
            continue
        if i >= len(step_results):
            continue
        # Preserve old value as value_pre_qc (only if not already present, to avoid overwriting on re-run)
        if "value_pre_qc" not in seg:
            seg["value_pre_qc"] = seg.get("value", "yes")
        seg["value"] = step_results[i].get("value", "yes")

    write_json(segments_path, segments_data)

    update_run_summary(
        run_summary_path,
        {
            "schema_fingerprint": schema_fp,
            "updated_at_utc": now_utc_iso(),
            "stage2h": {
                "status": "completed",
                "qc_summary_path": os.path.relpath(qc_summary_path, video_out),
                "num_steps": len(step_results),
                "num_hand_fail": num_hand_fail,
                "num_near": num_near,
                "num_far": num_far,
                "num_value_no": num_value_no,
                "depth_data_available": depth_reader is not None,
                "token_usage": stage_usage,
            },
        },
    )

    logger.info(
        f"[stage2h] video_id={vid} completed: steps={len(step_results)} hand_fail={num_hand_fail} "
        f"value_no={num_value_no} near={num_near} far={num_far} elapsed={format_duration(time.perf_counter() - t_start)}"
    )
    return video_out
