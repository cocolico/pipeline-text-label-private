#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Stage 2h: post-cut QC -- hand presence + near/far depth classification per step segment.

Runs after Stage 2 (video splitting) and before Stage 3 (text refinement). Performs real-time
YOLOv8 hand detection on the source video for each step segment, and reuses per-frame refined
depth chunks (`processed_refined_depth/refined_depth_*.npz`) stored as a sibling directory
of the pipeline's output root at the camera-recording level. Computes hand presence and motion
duration statistics, writes back the `value` field to `stage2/step_segments.json`, and outputs
detailed QC metrics to `stage2h/qc_summary.json`. This stage does not gate Stage 3 -- all
segments proceed to text refinement; downstream consumers decide whether/how to filter based
on the `value` field.
"""

from __future__ import annotations

